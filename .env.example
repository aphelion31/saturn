# Environment template for docker-compose.yaml (copy to .env and replace real secrets).
SATURN_VERSION=0.3.1
BIND_HOST=127.0.0.1
PORT=3000

POSTGRES_USER=saturn
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=saturn

SECRET_KEY=replace-with-openssl-rand-hex-50
WEB_URL=https://saturn.example.com

TRUST_PROXY=1
SATURN_JOBS=1
FILE_SIZE_LIMIT=5242880
DB_POOL=20
RUST_LOG=info,tower_http=warn

# Optional runtime toggles:
# ENABLE_SIGNUP=0
# ENABLE_DRF_SPECTACULAR=0
# CORS_ALLOWED_ORIGINS=https://saturn.example.com
# SATURN_RATE_LIMIT=10
# Local development database URL (`docker compose -f docker-compose.dev.yaml up -d`):
# DATABASE_URL=postgres://saturn:saturn@localhost:5432/saturn
