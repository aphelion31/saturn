# Production environment template for docker-compose.prod.yml (copy to .env and fill real secrets).
POSTGRES_USER=saturn
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=saturn
SECRET_KEY=replace-with-openssl-rand-hex-50
WEB_URL=https://plane.example.com
PORT=3000
TRUST_PROXY=1
SATURN_JOBS=1
FILE_SIZE_LIMIT=5242880
DB_POOL=20
RUST_LOG=info,tower_http=warn
